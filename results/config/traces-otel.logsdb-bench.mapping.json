{
  ".ds-traces-otel.logsdb-bench-2026.10.22-000001": {
    "mappings": {
      "dynamic": "strict",
      "_data_stream_timestamp": {
        "enabled": true
      },
      "properties": {
        "@timestamp": {
          "type": "date",
          "ignore_malformed": false
        },
        "attributes": {
          "properties": {
            "db": {
              "properties": {
                "system": {
                  "type": "keyword"
                }
              }
            },
            "exception": {
              "properties": {
                "message": {
                  "type": "match_only_text"
                },
                "type": {
                  "type": "keyword"
                }
              }
            },
            "http": {
              "properties": {
                "request": {
                  "properties": {
                    "method": {
                      "type": "keyword"
                    }
                  }
                },
                "response": {
                  "properties": {
                    "status_code": {
                      "type": "long"
                    }
                  }
                },
                "route": {
                  "type": "keyword"
                }
              }
            },
            "server": {
              "properties": {
                "address": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "duration": {
          "type": "long"
        },
        "host": {
          "properties": {
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "kind": {
          "type": "keyword"
        },
        "name": {
          "type": "keyword"
        },
        "parent_span_id": {
          "type": "keyword"
        },
        "resource": {
          "properties": {
            "attributes": {
              "properties": {
                "cloud": {
                  "properties": {
                    "region": {
                      "type": "keyword"
                    }
                  }
                },
                "deployment": {
                  "properties": {
                    "environment": {
                      "properties": {
                        "name": {
                          "type": "keyword"
                        }
                      }
                    }
                  }
                },
                "host": {
                  "properties": {
                    "name": {
                      "type": "keyword"
                    }
                  }
                },
                "k8s": {
                  "properties": {
                    "namespace": {
                      "properties": {
                        "name": {
                          "type": "keyword"
                        }
                      }
                    },
                    "pod": {
                      "properties": {
                        "name": {
                          "type": "keyword"
                        }
                      }
                    }
                  }
                },
                "service": {
                  "properties": {
                    "name": {
                      "type": "keyword"
                    },
                    "version": {
                      "type": "keyword"
                    }
                  }
                }
              }
            }
          }
        },
        "scope": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "version": {
              "type": "keyword"
            }
          }
        },
        "span_id": {
          "type": "keyword"
        },
        "status": {
          "properties": {
            "code": {
              "type": "keyword"
            },
            "message": {
              "type": "match_only_text"
            }
          }
        },
        "trace_id": {
          "type": "keyword"
        }
      }
    }
  }
}
